---
import { type Lang, person } from '@/data/profile';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentYear = new Date().getFullYear();

const links = Object.entries(person.links).map(([label, href]) => ({ href, label }));
---

<footer class="mt-32 md:mt-40">
  <div class="mx-auto max-w-container px-6 md:px-20">
    <div class="border-t border-rule pt-8 pb-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <div class="flex items-center gap-4">
        <img
          src="/assets/images/berlin.png"
          alt={lang === 'es' ? 'Alejandro Figueroa en Berlín' : 'Alejandro Figueroa in Berlin'}
          width="40"
          height="40"
          loading="lazy"
          class="h-10 w-10 rounded-full object-cover grayscale hover:grayscale-0 transition-[filter] duration-500"
        />
        <p class="font-mono text-[11px] tracking-mono lowercase text-text-subtle">
          &copy; {currentYear} Alejandro Figueroa
        </p>
      </div>

      <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-[11px] tracking-mono lowercase text-text-subtle hover:text-text transition-colors underline-grow"
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
