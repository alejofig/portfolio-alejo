---
import { copy, homePath, type Lang } from '@/data/profile';

export interface Props {
  lang: Lang;
  // Only the home pages have a translated counterpart.
  switchLang?: boolean;
}

const { lang, switchLang = false } = Astro.props;
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const navLinks = [
  { href: '/posts/', label: copy[lang].nav.writing },
  { href: '/llms.txt', label: 'llms.txt' },
  { href: 'https://github.com/alejofig', label: 'github', external: true },
  { href: 'https://www.linkedin.com/in/alejofig/', label: 'linkedin', external: true },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-page border-b border-line">
  <div class="mx-auto flex max-w-container items-center justify-between px-6 md:px-20 py-5">
    <a href={homePath[lang]} class="font-mono text-[13px] tracking-mono lowercase text-text hover:text-text transition-colors" aria-label="alejofig home">
      alejofig<span class="text-accent blink">.</span>
    </a>

    <div class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 sm:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="font-mono text-[12px] tracking-mono lowercase text-text-subtle hover:text-text transition-colors underline-grow"
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      {switchLang && (
        <a
          href={homePath[otherLang]}
          hreflang={otherLang}
          lang={otherLang}
          class="font-mono text-[12px] tracking-mono lowercase text-text-subtle hover:text-text transition-colors"
          aria-label={otherLang === 'en' ? 'Read in English' : 'Leer en español'}
        >
          <span class="text-text">{lang}</span> / {otherLang}
        </a>
      )}

      <button
        id="mobile-menu-btn"
        class="flex sm:hidden text-text-subtle hover:text-text"
        aria-label="Toggle menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden sm:hidden border-t border-rule px-6 pb-4">
    <ul class="flex flex-col gap-3 pt-3">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-mono text-[12px] tracking-mono lowercase text-text-subtle hover:text-text transition-colors"
            {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  document.addEventListener('astro:page-load', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => menu.classList.toggle('hidden'));
    }
  });
</script>
