---
export interface Props {
  num: number;
  id: string;
  title: string;
  note: string;
  // Wraps the content in the gallery "canvas" frame.
  frame?: boolean;
}

const { num, id, title, note, frame = true } = Astro.props;
---

<section id={id} class="panel dashed-b px-5 py-10 md:px-8 md:py-12 scroll-mt-0" aria-labelledby={`${id}-title`}>
  <header class="mb-4 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
    <span class="font-mono text-[11.5px] text-ink-3 tabular-nums">{String(num).padStart(2, '0')}</span>
    <h2 id={`${id}-title`} class="text-[14px] font-semibold text-ink">{title}</h2>
    <p class="text-[13px] text-ink-3">{note}</p>
  </header>
  {frame ? (
    <div class="flex min-h-[270px] items-center justify-center rounded-[14px] bg-canvas p-5 shadow-hairline md:p-10">
      <slot />
    </div>
  ) : (
    <slot />
  )}
</section>
