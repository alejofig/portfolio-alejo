---
import { copy, homePath, type Lang, person, panels } from '@/data/profile';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
---

<aside class="flex flex-col gap-7 px-5 pt-10 pb-8 md:sticky md:top-0 md:h-screen md:overflow-y-auto md:px-7 md:pt-14 dashed-b md:border-b-0 md:dashed-r">
  <div class="flex items-start justify-between">
    <img
      src={person.image}
      alt={person.name}
      width="44"
      height="44"
      class="size-11 rounded-full object-cover shadow-hairline"
    />
    <!-- theme toggle -->
    <div class="flex items-center rounded-full bg-field p-0.5 shadow-hairline" role="group" aria-label={t.sidebar.theme}>
      <button type="button" data-theme-set="light" aria-label={t.sidebar.light} class="theme-btn flex size-7 items-center justify-center rounded-full text-ink-3 transition-colors duration-150 hover:text-ink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
      <button type="button" data-theme-set="dark" aria-label={t.sidebar.dark} class="theme-btn flex size-7 items-center justify-center rounded-full text-ink-3 transition-colors duration-150 hover:text-ink">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      </button>
    </div>
  </div>

  <div>
    <h1 class="text-[22px] font-semibold leading-tight tracking-[-0.01em] text-ink">{person.name}</h1>
    <p class="mt-2 text-[14px] leading-relaxed text-ink-2">{t.intro}</p>
  </div>

  <nav class="hidden flex-col border-t border-dashed border-line-strong pt-6 md:flex" aria-label={t.sidebar.sections}>
    <p class="mb-2 text-[12px] text-ink-3">{t.sidebar.sections}</p>
    <ul class="flex flex-col">
      {panels.map((p) => (
        <li>
          <a
            href={`#${p.id}`}
            data-nav={p.id}
            class="nav-link flex h-7 items-center rounded-[6px] px-2 text-[13px] text-ink-2 transition-colors duration-100 hover:bg-hover-2 hover:text-ink"
          >
            {p.title[lang]}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="mt-auto flex flex-col gap-3 text-[12.5px]">
    <ul class="flex flex-wrap gap-x-3 gap-y-1">
      {Object.entries(person.links).map(([label, href]) => (
        <li>
          <a href={href} target="_blank" rel="noopener noreferrer" class="text-ink-2 underline-grow hover:text-ink">{label}</a>
        </li>
      ))}
    </ul>
    <div class="flex items-center gap-3 font-mono text-[11.5px] text-ink-3">
      <span>{person.locality} · CO</span>
      <a href="/llms.txt" class="hover:text-ink">llms.txt</a>
      <a href={homePath[otherLang]} hreflang={otherLang} lang={otherLang} class="hover:text-ink">
        <span class="text-ink">{lang}</span> / {otherLang}
      </a>
    </div>
  </div>
</aside>

<script>
  function initSidebar() {
    // theme toggle state
    const sync = () => {
      const dark = document.documentElement.classList.contains('dark');
      document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) => {
        const on = (b.dataset.themeSet === 'dark') === dark;
        b.classList.toggle('bg-surface', on);
        b.classList.toggle('shadow-btn', on);
        b.classList.toggle('text-ink', on);
        b.setAttribute('aria-pressed', String(on));
      });
    };
    document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) => {
      b.addEventListener('click', () => {
        const theme = b.dataset.themeSet!;
        document.documentElement.classList.toggle('dark', theme === 'dark');
        try { localStorage.setItem('theme', theme); } catch (e) { /* storage blocked */ }
        sync();
      });
    });
    sync();

    // highlight the panel in view
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-nav]').forEach((a) => links.set(a.dataset.nav!, a));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((a, id) => {
            const on = id === entry.target.id;
            a.classList.toggle('bg-hover-2', on);
            a.classList.toggle('text-ink', on);
          });
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    document.querySelectorAll('section.panel').forEach((s) => observer.observe(s));
  }
  document.addEventListener('astro:page-load', initSidebar);
</script>
